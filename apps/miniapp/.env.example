# Base URL of the THD API, including the /api prefix.
# Defaults to a same-origin "/api" when unset.
VITE_API_BASE_URL=http://localhost:3000/api

# Dev only. Pairs with the API's AUTH_MOCK_ENABLED=true.
# JSON shape: {"id":123,"firstName":"Ada","lastName":"Lovelace","username":"ada"}
# Leave empty when running inside Telegram (real initData is used automatically).
VITE_MOCK_USER=
