# Telegram bot token from @BotFather
BOT_TOKEN=change_me
# API base URL (the API service)
API_BASE_URL=http://localhost:3000
# Must match the API's API_INTERNAL_TOKEN
API_INTERNAL_TOKEN=change_me
# Deep link target for the /start button (Telegram Mini App URL)
MINIAPP_URL=https://t.me/your_bot/app
# polling (dev) or webhook (prod). Defaults from NODE_ENV if unset.
BOT_MODE=polling
# Required when BOT_MODE=webhook
BOT_WEBHOOK_DOMAIN=https://bot.example.com
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_SECRET=change_me
BOT_WEBHOOK_PORT=8080
# API request timeout (ms)
API_TIMEOUT_MS=5000
NODE_ENV=development
