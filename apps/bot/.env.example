# Telegram bot token from @BotFather
BOT_TOKEN=change_me
# API base URL (the API service)
API_BASE_URL=http://localhost:3000
# Must match the API's API_INTERNAL_TOKEN
API_INTERNAL_TOKEN=change_me
# Deep link target for the /start button (Telegram Mini App URL)
MINIAPP_URL=https://t.me/your_bot/app
# Channel id or @username used for join-request delivery and invite links
BOT_CHANNEL_ID=@your_channel
# Outbox delivery loop cadence (ms) and max tasks per tick
BOT_OUTBOX_POLL_INTERVAL_MS=5000
BOT_OUTBOX_BATCH_SIZE=10
# Max content tasks published/deleted per tick
BOT_CONTENT_BATCH_SIZE=10
# Reconcile channel membership every 15 minutes, at most 20 getChatMember calls/sec
BOT_MEMBERSHIP_SYNC_INTERVAL_MS=900000
BOT_MEMBERSHIP_SYNC_RATE_PER_SEC=20
# Member-removal outbox batch size per tick
BOT_MEMBER_REMOVAL_BATCH_SIZE=10
# Notification outbox batch size per tick
BOT_NOTIFICATION_BATCH_SIZE=10
# polling (dev) or webhook (prod). Defaults from NODE_ENV if unset.
BOT_MODE=polling
# Required when BOT_MODE=webhook
BOT_WEBHOOK_DOMAIN=https://bot.example.com
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_SECRET=change_me
BOT_WEBHOOK_PORT=8080
# API request timeout (ms)
API_TIMEOUT_MS=5000
NODE_ENV=development
