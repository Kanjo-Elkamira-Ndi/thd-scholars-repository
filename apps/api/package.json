{
  "name": "@thd/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsc -p tsconfig.json && node dist/db/migrate.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "tsx src/db/seeds/seed-users.ts",
    "make:init-data": "tsx scripts/make-init-data.ts"
  },
  "dependencies": {
    "@thd/shared": "*",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "vitest": "^5.0.3"
  }
}
