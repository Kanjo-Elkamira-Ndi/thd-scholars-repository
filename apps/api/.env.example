DATABASE_URL=postgresql://postgres:postgres@localhost:5432/thd_scholars
API_INTERNAL_TOKEN=change_me
MINIAPP_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
BOT_TOKEN=change_me
TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
AUTH_MOCK_ENABLED=false
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=900
REGISTRATION_RATE_LIMIT_MAX=5
REPEATED_REGISTRATION_FAILURE_THRESHOLD=3
REPEATED_REGISTRATION_FAILURE_WINDOW_SECONDS=86400
JOIN_REQUEST_DELIVERY_MAX_ATTEMPTS=5
JOIN_REQUEST_DELIVERY_BACKOFF_BASE_SECONDS=60
JOIN_REQUEST_DELIVERY_LEASE_SECONDS=120
JOIN_REQUEST_DELIVERY_BATCH_SIZE=10
# Content staging: persistent volume for files routed to Telegram. Must survive restarts.
CONTENT_STAGING_DIR=.staging/content
CONTENT_DELIVERY_MAX_ATTEMPTS=5
CONTENT_DELIVERY_BACKOFF_BASE_SECONDS=60
CONTENT_DELIVERY_LEASE_SECONDS=120
CONTENT_DELIVERY_BATCH_SIZE=10
# Drive routing for large uploads. Requires the API service account to have access
# to a Shared Drive; files are uploaded resumable and shared anyone-with-link (reader).
# Leave unset to disable Drive and force Telegram-only routing.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=