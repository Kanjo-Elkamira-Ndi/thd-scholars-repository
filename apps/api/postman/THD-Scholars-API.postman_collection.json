{
  "info": {
    "name": "THD Scholars API — Phase 6 (Roster + Registration)",
    "_postman_id": "b7f0a2c4-6d51-4e8a-9c3b-1f2e3d4a5c6b",
    "description": "Covers the Phase 6 endpoints (see docs/context/api-reference.md).\n\nSETUP\n1. In apps/api/.env set AUTH_MOCK_ENABLED=true and add a non-empty BOT_TOKEN, then run the API: `npm run dev --workspace=apps/api`.\n2. Seed dev users: `npm run seed --workspace=apps/api` (scholar 1111111111, faculty 2222222222, registrar 3333333333, admin 4444444444).\n3. Import this collection and the paired environment (THD-Scholars-API.postman_environment.json), select it, then run the requests in the \"0. Setup\" folder once before the rest.\n\nAUTH\nEach request declares its identity with an `X-Role` header. The collection-level pre-request script removes it and, depending on the `authMode` environment variable:\n- `mock` (default): sets `X-Mock-User` for that role (requires AUTH_MOCK_ENABLED=true).\n- `tma`: sets `Authorization: tma <initData>` from the `<role>InitData` environment variable (generate with `npm run make:init-data --workspace=apps/api -- --role=<role>`).\n\nNOTE: The mock auth path keeps the existing DB role, so seed BEFORE sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const mode = (pm.environment.get('authMode') || 'mock').toLowerCase();",
          "const role = (pm.request.headers.get('X-Role') || 'scholar').toLowerCase();",
          "pm.request.headers.remove('X-Role');",
          "",
          "if (mode === 'tma') {",
          "  const map = {",
          "    scholar: pm.environment.get('scholarInitData'),",
          "    faculty: pm.environment.get('facultyInitData'),",
          "    registrar: pm.environment.get('registrarInitData'),",
          "    admin: pm.environment.get('adminInitData')",
          "  };",
          "  const init = map[role];",
          "  if (init) {",
          "    pm.request.headers.upsert({ key: 'Authorization', value: 'tma ' + init });",
          "  } else {",
          "    console.warn('authMode=tma but no initData for role ' + role);",
          "  }",
          "} else {",
          "  const ids = { scholar: 1111111111, faculty: 2222222222, registrar: 3333333333, admin: 4444444444 };",
          "  pm.request.headers.upsert({",
          "    key: 'X-Mock-User',",
          "    value: JSON.stringify({ id: ids[role], username: 'dev_' + role })",
          "  });",
          "}"
        ]
      }
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "rosterId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Setup",
      "item": [
        {
          "name": "GET /api/me (scholar sanity)",
          "request": {
            "method": "GET",
            "header": [{ "key": "X-Role", "value": "scholar" }],
            "url": {
              "raw": "{{baseUrl}}/api/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "me"]
            },
            "description": "Confirms auth works and returns the current user + roster."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('has user', () => pm.expect(pm.response.json()).to.have.property('user'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup A — create roster DIBI-THD-0042 (starts pending)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Role", "value": "registrar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationId\": \"DIBI-THD-0042\",\n  \"cohortYear\": 2025,\n  \"programTrack\": \"Theology\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/roster",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roster"]
            },
            "description": "Creates the entry used by the approval case; saves its id into {{rosterId}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 or 409 if it already exists', () => pm.expect([201, 409]).to.include(pm.response.code));",
                  "const j = pm.response.json();",
                  "if (j && j.rosterEntry && j.rosterEntry.id) { pm.collectionVariables.set('rosterId', j.rosterEntry.id); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup B — activate roster DIBI-THD-0042",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Role", "value": "registrar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"active\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/roster/{{rosterId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roster", "{{rosterId}}"]
            },
            "description": "Activates the row from Setup A so the approval case matches."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 active', () => {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().rosterEntry.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup B2 — create roster DIBI-THD-0055 (leave pending)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Role", "value": "registrar" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"registrationId\": \"DIBI-THD-0055\",\n  \"cohortYear\": 2024,\n  \"programTrack\": \"Ministry\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/roster",
              "host": ["{{baseUrl}}"],
              "path": ["api", "roster"]
            },
            "description": "A matched-but-not-active row for the registration 'pending match' case. Do NOT activate it."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 CREATED or 409 if it already exists', () => pm.expect([201, 409]).to.include(pm.response.code));"
                ]
              }
            }
          ]
        }
      ]
